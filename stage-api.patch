diff --git a/internal/plugin/stage.go b/internal/plugin/stage.go
new file mode 100644
index 0000000..e1eaf62
--- /dev/null
+++ b/internal/plugin/stage.go
@@ -0,0 +1,149 @@
+package plugin
+
+import (
+	"fmt"
+	"math"
+	"time"
+)
+
+// Stage API 1 is an opt-in drawing source, separate from a music source.
+// Coordinates are logical pixels; text is rasterized at its final font size.
+type StageMode struct {
+	ID    string `json:"id"`
+	Label string `json:"label"`
+}
+type StageWord struct {
+	Text  string `json:"text"`
+	Start int64  `json:"start"`
+	End   int64  `json:"end"`
+}
+type StageLine struct {
+	Text        string      `json:"text"`
+	Translation string      `json:"translation"`
+	Start       int64       `json:"start"`
+	End         int64       `json:"end"`
+	Words       []StageWord `json:"words"`
+}
+type StageInput struct {
+	APIVersion   int        `json:"apiVersion"`
+	Width        float32    `json:"width"`
+	Height       float32    `json:"height"`
+	Position     int64      `json:"position"`
+	Playing      bool       `json:"playing"`
+	ReduceMotion bool       `json:"reduceMotion"`
+	TrackID      string     `json:"trackId"`
+	Title        string     `json:"title"`
+	Mode         string     `json:"mode"`
+	Accent       [3]uint8   `json:"accent"`
+	Bands        []float32  `json:"bands"`
+	HasSpectrum  bool       `json:"hasSpectrum"`
+	Current      *StageLine `json:"current"`
+	Previous     *StageLine `json:"previous"`
+	Next         *StageLine `json:"next"`
+}
+type StagePoint struct {
+	X float32 `json:"x"`
+	Y float32 `json:"y"`
+}
+type StagePrimitive struct {
+	Kind   string       `json:"kind"`
+	X      float32      `json:"x"`
+	Y      float32      `json:"y"`
+	X2     float32      `json:"x2"`
+	Y2     float32      `json:"y2"`
+	Radius float32      `json:"radius"`
+	Width  float32      `json:"width"`
+	Text   string       `json:"text"`
+	Size   float32      `json:"size"`
+	Weight int          `json:"weight"`
+	Align  string       `json:"align"`
+	Color  [4]uint8     `json:"color"`
+	Points []StagePoint `json:"points,omitempty"`
+	Runs   []StageRun   `json:"runs,omitempty"`
+}
+
+type StageRun struct {
+	Text    string   `json:"text"`
+	Scale   float32  `json:"scale"`
+	Opacity float32  `json:"opacity"`
+	Rise    float32  `json:"rise"`
+	Color   [4]uint8 `json:"color"`
+}
+type StageScene struct {
+	Background [4]uint8         `json:"background"`
+	Primitives []StagePrimitive `json:"primitives"`
+}
+
+func (p *Plugin) HasStage() bool          { return p.manifest.StageAPI == 1 && p.Can("stageFrame") }
+func (p *Plugin) StageModes() []StageMode { return append([]StageMode(nil), p.manifest.StageModes...) }
+
+// StageFrame runs off the UI thread, with one outstanding call per stage.
+func (p *Plugin) StageFrame(in StageInput) (*StageScene, error) {
+	if !p.HasStage() {
+		return nil, fmt.Errorf("unsupported stage API")
+	}
+	var scene StageScene
+	if err := p.callWithin(250*time.Millisecond, "stageFrame", in, &scene); err != nil {
+		return nil, err
+	}
+	if err := scene.Validate(); err != nil {
+		return nil, err
+	}
+	return &scene, nil
+}
+
+// Validate bounds drawing work and rejects non-finite geometry before it
+// reaches the renderer. Unknown commands fail visibly instead of being ignored.
+func (s *StageScene) Validate() error {
+	if len(s.Primitives) > 384 {
+		return fmt.Errorf("stage exceeds 384 primitives")
+	}
+	points, text, runs := 0, 0, 0
+	for _, n := range s.Primitives {
+		switch n.Kind {
+		case "text", "words", "circle", "ring", "line", "path":
+		default:
+			return fmt.Errorf("unknown stage primitive %q", n.Kind)
+		}
+		for _, v := range []float32{n.X, n.Y, n.X2, n.Y2, n.Radius, n.Width, n.Size} {
+			if math.IsNaN(float64(v)) || math.IsInf(float64(v), 0) || v < -32768 || v > 32768 {
+				return fmt.Errorf("invalid stage geometry")
+			}
+		}
+		if n.Radius < 0 || n.Radius > 8192 || n.Width < 0 || n.Width > 128 || n.Size < 0 || n.Size > 320 {
+			return fmt.Errorf("stage size out of range")
+		}
+		if (n.Kind == "text" || n.Kind == "words") && (n.Size < 1 || n.Weight < 100 || n.Weight > 900) {
+			return fmt.Errorf("invalid stage text style")
+		}
+		text += len(n.Text)
+		runs += len(n.Runs)
+		if runs > 384 {
+			return fmt.Errorf("stage total word budget exceeded")
+		}
+		if len(n.Runs) > 160 {
+			return fmt.Errorf("stage word budget exceeded")
+		}
+		for _, run := range n.Runs {
+			text += len(run.Text)
+			for _, v := range []float32{run.Scale, run.Opacity, run.Rise} {
+				if math.IsNaN(float64(v)) || math.IsInf(float64(v), 0) {
+					return fmt.Errorf("invalid stage word")
+				}
+			}
+			if run.Scale < 0.5 || run.Scale > 2 || run.Opacity < 0 || run.Opacity > 1 || math.Abs(float64(run.Rise)) > 500 {
+				return fmt.Errorf("stage word out of range")
+			}
+		}
+		points += len(n.Points)
+		if text > 16384 || points > 4096 {
+			return fmt.Errorf("stage drawing budget exceeded")
+		}
+		for _, v := range n.Points {
+			if math.IsNaN(float64(v.X)) || math.IsNaN(float64(v.Y)) || math.IsInf(float64(v.X), 0) || math.IsInf(float64(v.Y), 0) || math.Abs(float64(v.X)) > 32768 || math.Abs(float64(v.Y)) > 32768 {
+				return fmt.Errorf("invalid stage path")
+			}
+		}
+	}
+	return nil
+}
diff --git a/internal/plugin/stage_test.go b/internal/plugin/stage_test.go
new file mode 100644
index 0000000..1cfe50d
--- /dev/null
+++ b/internal/plugin/stage_test.go
@@ -0,0 +1,42 @@
+package plugin
+
+import (
+	"math"
+	"testing"
+)
+
+// A stage receives the current song's timing and returns validated drawing data.
+func TestStageProtocol(t *testing.T) {
+	p := load(t, `{"id":"stage","stageApi":1}`, `export function stageFrame(v) { return {primitives:[{kind:"text",text:v.trackId+":"+v.position,x:20,y:40,size:32,weight:600,color:[255,255,255,255]}]}; }`)
+	scene, err := p.StageFrame(StageInput{APIVersion: 1, TrackID: "source:track", Position: 1234})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if scene.Primitives[0].Text != "source:track:1234" {
+		t.Fatal(scene)
+	}
+}
+
+// Invalid commands and unbounded geometry never enter the native renderer.
+func TestStageRejectsInvalidDrawing(t *testing.T) {
+	for _, s := range []StageScene{
+		{Primitives: make([]StagePrimitive, 385)},
+		{Primitives: []StagePrimitive{{Kind: "script"}}},
+		{Primitives: []StagePrimitive{{Kind: "circle", Radius: -1}}},
+		{Primitives: []StagePrimitive{{Kind: "line", X: float32(math.NaN())}}},
+		{Primitives: []StagePrimitive{{Kind: "text", Size: 999, Weight: 600}}},
+		{Primitives: []StagePrimitive{{Kind: "path", Points: make([]StagePoint, 4097)}}},
+	} {
+		if s.Validate() == nil {
+			t.Fatalf("accepted invalid scene: %+v", s)
+		}
+	}
+}
+
+// A stage that never resolves times out rather than occupying its worker forever.
+func TestStagePendingPromiseTimesOut(t *testing.T) {
+	p := load(t, `{"id":"stage","stageApi":1}`, `export function stageFrame() { return new Promise(()=>{}); }`)
+	if _, err := p.StageFrame(StageInput{}); err == nil {
+		t.Fatal("expected timeout")
+	}
+}
