+package app
+
+import (
+	"github.com/egoist/mygo/ui"
+	"mygo-music/internal/plugin"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func stageFixture(t *testing.T) *plugin.Plugin {
+	t.Helper()
+	dir := t.TempDir()
+	os.WriteFile(filepath.Join(dir, "plugin.json"), []byte(`{"id":"test-stage","name":"Test Stage","stageApi":1,"stageModes":[{"id":"test","label":"Test"}]}`), 0600)
+	os.WriteFile(filepath.Join(dir, "index.js"), []byte(`export function stageFrame(i) {return {primitives:[{kind:"text",text:i.title,x:i.width/2,y:i.height/2,size:32,weight:600,align:"center",color:[255,255,255,255]}]}}`), 0600)
+	p, err := plugin.Load(dir, t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(p.Close)
+	return p
+}
+
+// Selecting a renderer changes only the stage, and selecting Flow returns to it.
+func TestStagePluginSelection(t *testing.T) {
+	a, tt, _ := playingApp()
+	a.plugins = []*plugin.Plugin{stageFixture(t)}
+	ch := posts(a)
+	source := a.library
+	a.nowPlaying, a.npPane = true, paneStage
+	tt.Move(600, 400)
+	tt.Advance(time.Second)
+	if err := tt.Click("Stage Style"); err != nil {
+		t.Fatal(err)
+	}
+	if err := tt.ChooseMenuItem("Test Stage · Test"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Frame()
+	if a.settings.StagePlugin != "test-stage" || a.library != source {
+		t.Fatal("renderer changed music source or did not select")
+	}
+	until(t, ch, func() bool {
+		return a.stageRuntime != nil && (a.stageRuntime.scene != nil || a.stageRuntime.err != nil)
+	})
+	tt.Frame()
+	if a.stageRuntime == nil || a.stageRuntime.scene == nil {
+		t.Fatalf("no scene: %+v", a.stageRuntime)
+	}
+	if err := tt.Click("Stage Style"); err != nil {
+		t.Fatal(err)
+	}
+	if err := tt.ChooseMenuItem("Flow"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Frame()
+	if a.settings.StagePlugin != "" || a.stageRuntime != nil {
+		t.Fatal("did not restore built-in stage")
+	}
+}
+
+// Optional native previews execute the real installed plugin at screen sizes,
+// rather than rendering a separate browser imitation of its output.
+func TestStagePluginFrames(t *testing.T) {
+	dir := framesDir(t)
+	source := os.Getenv("MYGO_STAGE_PLUGIN_DIR")
+	if source == "" {
+		t.Skip()
+	}
+	p, err := plugin.Load(source, t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.Close()
+	for _, mode := range []string{"cinema"} {
+		a, _, _ := playingApp()
+		a.plugins = []*plugin.Plugin{p}
+		a.settings.StagePlugin = p.Info().ID
+		a.settings.StageMode = mode
+		a.nowPlaying, a.npPane = true, paneStage
+		a.pl.Seek(12300 * time.Millisecond)
+		ch := posts(a)
+		tt := ui.NewTester(a.view, 1600, 1000)
+		tt.SetDark(true)
+		tt.SetPreferences(ui.Preferences{ReduceMotion: true})
+		tt.Frame()
+		until(t, ch, func() bool { return a.stageRuntime.scene != nil || a.stageRuntime.err != nil })
+		tt.Advance(time.Second)
+		tt.Frame()
+		if a.stageRuntime.busy {
+			until(t, ch, func() bool { return !a.stageRuntime.busy })
+			tt.Frame()
+		}
+		if a.stageRuntime.err != nil {
+			t.Fatal(a.stageRuntime.err)
+		}
+		saveFrame(t, dir, "studio-"+mode+".png", tt.Image())
+	}
+}
+
+// Word runs once reused a sibling's key and dropped trailing spaces, causing
+// panics and joined words; both rows must coexist and preserve a visible gap.
+func TestStageWordRowsKeepSpacing(t *testing.T) {
+	word := func(s string) plugin.StageRun {
+		return plugin.StageRun{Text: s, Scale: 1, Opacity: 1, Color: [4]uint8{255, 255, 255, 255}}
+	}
+	scene := &plugin.StageScene{Primitives: []plugin.StagePrimitive{
+		{Kind: "text", Text: "Heading", X: 20, Y: 10, Size: 14, Weight: 400, Color: [4]uint8{255, 255, 255, 255}},
+		{Kind: "words", X: 20, Y: 60, Size: 40, Weight: 500, Runs: []plugin.StageRun{word("Hello "), word("world")}},
+		{Kind: "words", X: 20, Y: 130, Size: 40, Weight: 500, Runs: []plugin.StageRun{word("Second "), word("row")}},
+	}}
+	tt := ui.NewTester(func(c *ui.Context) { drawStageScene(c, ui.Box(c).Fill(), scene, 800) }, 800, 400)
+	tt.Frame()
+	a, ok := tt.Find("Hello ")
+	if !ok {
+		t.Fatalf("missing first word: %q", tt.Texts())
+	}
+	b, ok := tt.Find("world")
+	if !ok {
+		t.Fatal("missing second word")
+	}
+	if b.X < a.X+a.W+3 {
+		t.Fatalf("words lost their gap: first %+v, second %+v", a, b)
+	}
+	if !tt.HasText("Second ") {
+		t.Fatal("missing second row")
+	}
+}
