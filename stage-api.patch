@@ -0,0 +1,51 @@
+package app
+
+import (
+	"encoding/json"
+	"fmt"
+	"github.com/egoist/mygo/ui"
+	"mygo-music/internal/plugin"
+	"os"
+	"testing"
+)
+
+// With explicit offline inputs, renders the real plugin through the live stage's
+// drawing code. No recording, playback, or access to the user's library occurs.
+func TestStageMovie(t *testing.T) {
+	source, inputs := os.Getenv("MYGO_STAGE_PLUGIN_DIR"), os.Getenv("MYGO_STAGE_MOVIE_INPUT")
+	if source == "" || inputs == "" {
+		t.Skip()
+	}
+	dir := framesDir(t)
+	b, err := os.ReadFile(inputs)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var frames []plugin.StageInput
+	if err = json.Unmarshal(b, &frames); err != nil {
+		t.Fatal(err)
+	}
+	p, err := plugin.Load(source, t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.Close()
+	if len(frames) == 0 {
+		t.Fatal("no frames")
+	}
+	var scene *plugin.StageScene
+	tt := ui.NewTester(func(c *ui.Context) {
+		if scene != nil {
+			drawStageScene(c, ui.Box(c).Fill().Clip(), scene, frames[0].Width)
+		}
+	}, int(frames[0].Width), int(frames[0].Height))
+	tt.SetDark(true)
+	for i, in := range frames {
+		scene, err = p.StageFrame(in)
+		if err != nil {
+			t.Fatal(err)
+		}
+		tt.Frame()
+		saveFrame(t, dir, fmt.Sprintf("frame-%04d.png", i), tt.Image())
+	}
+}
