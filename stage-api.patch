diff --git a/internal/app/ui_stage_plugin.go b/internal/app/ui_stage_plugin.go
new file mode 100644
index 0000000..cf9269d
--- /dev/null
+++ b/internal/app/ui_stage_plugin.go
@@ -0,0 +1,220 @@
+package app
+
+import (
+	"reflect"
+	"slices"
+	"time"
+
+	"github.com/egoist/mygo/ui"
+	"mygo-music/internal/lyrics"
+	"mygo-music/internal/music"
+	"mygo-music/internal/plugin"
+)
+
+type stageRuntime struct {
+	source *plugin.Plugin
+	mode   string
+	bounds ui.Handle
+	busy   bool
+	last   time.Time
+	input  plugin.StageInput
+	scene  *plugin.StageScene
+	err    error
+}
+
+func (a *app) stagePlugins() []*plugin.Plugin {
+	var out []*plugin.Plugin
+	for _, p := range a.plugins {
+		if p.HasStage() && !slices.Contains(a.settings.DisabledPlugins, p.Info().ID) {
+			out = append(out, p)
+		}
+	}
+	return out
+}
+
+func stageLineInput(l *lyrics.Line) *plugin.StageLine {
+	if l == nil {
+		return nil
+	}
+	out := &plugin.StageLine{Text: l.Text, Translation: l.Translation, Start: l.At.Milliseconds(), End: l.End.Milliseconds()}
+	for _, w := range l.Words {
+		out.Words = append(out.Words, plugin.StageWord{Text: w.Text, Start: w.Start.Milliseconds(), End: w.End.Milliseconds()})
+	}
+	return out
+}
+
+// pluginStage schedules at most one worker per selected renderer. The last
+// completed immutable scene paints while its successor is calculated.
+func (a *app) pluginStage(c *ui.Context, tr *music.Track, accent ui.Color) bool {
+	if a.settings.StagePlugin == "" {
+		a.stageRuntime = nil
+		return false
+	}
+	var selected *plugin.Plugin
+	for _, p := range a.stagePlugins() {
+		if p.Info().ID == a.settings.StagePlugin {
+			selected = p
+			break
+		}
+	}
+	if selected == nil {
+		a.stageRuntime = nil
+		ui.Text(c, T("Stage plugin unavailable; using built-in lyrics.")).FontSize(12).TextColor(white.Alpha(0.6))
+		return false
+	}
+	s := a.stageRuntime
+	if s == nil || s.source != selected || s.mode != a.settings.StageMode {
+		s = &stageRuntime{source: selected, mode: a.settings.StageMode}
+		a.stageRuntime = s
+	}
+	if s.err != nil {
+		ui.Text(c, T("Stage plugin stopped; select it again to retry.")).FontSize(12).TextColor(white.Alpha(0.6)).Tooltip(s.err.Error())
+		return false
+	}
+	r := s.bounds.Bounds(c)
+	w, h := c.Size()
+	if r.W > 0 && r.H > 0 {
+		w, h = r.W, r.H
+	} else {
+		h = max(100, h-180)
+	}
+	pos := a.pl.Position()
+	bands, live := a.pl.Levels()
+	in := plugin.StageInput{APIVersion: 1, Width: w, Height: h, Position: pos.Milliseconds(), Playing: a.pl.Playing(), ReduceMotion: c.Preferences().ReduceMotion, TrackID: tr.Source + ":" + tr.ID, Title: tr.Name, Mode: s.mode, Accent: [3]uint8{accent.R, accent.G, accent.B}, Bands: append([]float32(nil), bands[:]...), HasSpectrum: live}
+	lines, _ := a.pl.Lyrics()
+	cur := lyrics.Index(lines, pos)
+	if cur >= 0 {
+		in.Current = stageLineInput(&lines[cur])
+	}
+	if cur > 0 {
+		in.Previous = stageLineInput(&lines[cur-1])
+	}
+	if cur+1 < len(lines) {
+		in.Next = stageLineInput(&lines[cur+1])
+	}
+	now := c.Now()
+	changed := !reflect.DeepEqual(in, s.input)
+	if !s.busy && changed && (s.last.IsZero() || now.Sub(s.last) >= time.Second/30) {
+		s.busy = true
+		s.last = now
+		s.input = in
+		// The snapshot owns its slices. No UI context or element leaves this thread.
+		go func() {
+			scene, err := selected.StageFrame(in)
+			a.post(func() {
+				if a.stageRuntime != s || a.quitting {
+					return
+				}
+				s.busy = false
+				s.scene = scene
+				s.err = err
+			})
+		}()
+	}
+	if in.Playing || changed && !s.busy {
+		c.After(time.Second / 30)
+	}
+	box := ui.Box(c.Key("plugin-stage")).Grow(1).Bind(&s.bounds).Clip().PassThrough()
+	a.npRise(box, 1)
+	if s.scene == nil {
+		box.Children(func() { ui.Text(c, T("Loading stage plugin…")).FontSize(16).TextColor(white.Alpha(0.5)) })
+		return true
+	}
+	scene := s.scene
+	drawStageScene(c, box, scene, w)
+	return true
+}
+
+// drawStageScene is shared by the live stage and native offline previews.
+func drawStageScene(c *ui.Context, box ui.Element, scene *plugin.StageScene, w float32) {
+	bg := scene.Background
+	box.Background(ui.RGB(bg[0], bg[1], bg[2]).Alpha(float32(bg[3]) / 255))
+	box.Draw(func(p *ui.Painter, r ui.Rect) {
+		for _, n := range scene.Primitives {
+			color := ui.RGB(n.Color[0], n.Color[1], n.Color[2]).Alpha(float32(n.Color[3]) / 255)
+			switch n.Kind {
+			case "circle":
+				p.FillPath((&ui.Path{}).Circle(r.X+n.X, r.Y+n.Y, n.Radius), color)
+			case "ring":
+				p.StrokePath((&ui.Path{}).Circle(r.X+n.X, r.Y+n.Y, n.Radius), n.Width, color)
+			case "line":
+				p.StrokePath((&ui.Path{}).MoveTo(r.X+n.X, r.Y+n.Y).LineTo(r.X+n.X2, r.Y+n.Y2), n.Width, color)
+			case "path":
+				path := &ui.Path{}
+				for i, pt := range n.Points {
+					if i == 0 {
+						path.MoveTo(r.X+pt.X, r.Y+pt.Y)
+					} else {
+						path.LineTo(r.X+pt.X, r.Y+pt.Y)
+					}
+				}
+				if len(n.Points) > 1 {
+					p.StrokePath(path, n.Width, color)
+				}
+			}
+		}
+	}).Children(func() {
+		for i, n := range scene.Primitives {
+			if n.Kind == "words" {
+				drawStageWords(c, n, w, i)
+				continue
+			}
+			if n.Kind != "text" {
+				continue
+			}
+			size := float32(int(n.Size + 0.5)) // bounded glyph-cache sizes while words swell
+			tw, _ := c.MeasureText(0, ui.Span{Text: n.Text, Size: size, Weight: n.Weight})
+			if tw > w-32 {
+				size = max(1, size*(w-32)/tw)
+				tw = w - 32
+			}
+			x := n.X
+			if n.Align == "center" {
+				x -= tw / 2
+			} else if n.Align == "right" {
+				x -= tw
+			}
+			ui.Text(c.Key(i), n.Text).Absolute().Left(max(0, x)).Top(n.Y).FontSize(size).FontWeight(n.Weight).NoWrap().
+				TextColor(ui.RGB(n.Color[0], n.Color[1], n.Color[2]).Alpha(float32(n.Color[3]) / 255))
+		}
+	})
+}
+
+// Native measurements preserve real word spacing while the plugin choreographs
+// each word. The cell stays put; its glyphs use the final animated font size.
+func drawStageWords(c *ui.Context, n plugin.StagePrimitive, w float32, row int) {
+	size := n.Size
+	widths := make([]float32, len(n.Runs))
+	total := float32(0)
+	marker, _ := c.MeasureText(0, ui.Span{Text: "|", Size: size, Weight: n.Weight})
+	for i, run := range n.Runs {
+		// Text measurements omit trailing spaces; a visible sentinel retains
+		// them so separate words do not run together.
+		widths[i], _ = c.MeasureText(0, ui.Span{Text: run.Text + "|", Size: size, Weight: n.Weight})
+		widths[i] -= marker
+		total += widths[i]
+	}
+	avail := max(32, w-2*n.X)
+	if n.Align == "center" {
+		avail = w * 0.84
+	}
+	if total > avail {
+		k := avail / total
+		size *= k
+		total = avail
+		for i := range widths {
+			widths[i] *= k
+		}
+	}
+	x := n.X
+	if n.Align == "center" {
+		x -= total / 2
+	}
+	for i, run := range n.Runs {
+		fs := float32(int(size*run.Scale + 0.5))
+		col := run.Color
+		ui.Text(c.Key([2]int{row, i}), run.Text).Absolute().Left(x).Top(n.Y + run.Rise).
+			FontSize(max(1, fs)).FontWeight(n.Weight).NoWrap().TextColor(ui.RGB(col[0], col[1], col[2]).Alpha(float32(col[3]) / 255 * run.Opacity))
+		x += widths[i]
+	}
+}
